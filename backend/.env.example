# Application
APP_NAME=ChatSphere API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Supabase Hosted PostgreSQL Connection String (Direct or Session Pooler)
# Example: postgresql+psycopg://postgres.<project_ref>:<db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# JWT Security (Generate a strong 32+ char random secret for production)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional email recovery configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Supabase PostgreSQL connection (backend-only; never expose service-role keys to the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# File Storage
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=storage_uploads
MAX_UPLOAD_SIZE_MB=25
